{
  "name": "mastra-weflayr",
  "version": "0.1.0",
  "description": "Run Mastra agents on Weflayr routing strategies with every call tagged by customer and run, and stop a customer's run on their real AI cost or margin.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "example": "tsx examples/live.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mastra",
    "weflayr",
    "ai-gateway",
    "llm",
    "routing",
    "model-routing",
    "margin",
    "budgets",
    "agents",
    "multi-tenant"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/mastra-weflayr.git"
  },
  "homepage": "https://github.com/sholajegede/mastra-weflayr#readme",
  "bugs": {
    "url": "https://github.com/sholajegede/mastra-weflayr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.34.0 <2.0.0-0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mastra/core": "^1.82.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
